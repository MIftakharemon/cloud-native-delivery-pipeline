# EditorConfig: https://editorconfig.org/
# Top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[*.tf]
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = single

[*.{json,jsonc}]
indent_size = 2

[Dockerfile*]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.{sh,bash}]
indent_size = 2